{
  "name": "sidecar-pane",
  "version": "0.0.1",
  "private": true,
  "description": "A viewer pane that sits beside the Claude Code CLI: file tree, previews, and (soon) live diffs.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/cli.tsx",
    "pane": "node scripts/open-pane.mjs",
    "snapshot": "tsx src/cli.tsx --snapshot",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "lowlight": "^3.3.0",
    "react": "^19.2.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0"
  }
}
